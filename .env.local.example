# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (Claude API for admin AI chat)
ANTHROPIC_API_KEY=your-anthropic-api-key

# RD Station (server-only — NÃO usar prefixo NEXT_PUBLIC_, isso exporia o token ao browser)
RD_STATION_TOKEN=your-rd-token

# Segredo do HMAC para pseudonimização de IP/CPF/e-mail (LGPD).
# OBRIGATÓRIO. Use um valor aleatório forte (>= 16 chars). Ex.: openssl rand -hex 32
IP_HASH_SALT=

# Segredo do endpoint de revalidação de cache (/api/revalidate). OBRIGATÓRIO para usar a rota.
REVALIDATION_SECRET=

# Site URL
NEXT_PUBLIC_SITE_URL=https://planoviversaude.com.br
